----------------------------------------------------------------
-- 1. Find customers who have placed orders using IN clause
SELECT * FROM Customer

WHERE CustomerID IN (
    SELECT CustomerID FROM Orders
);

----------------------------------------------------------------
-- 2. Find customers who have not placed any orders using NOT IN
SELECT *
FROM Customer
WHERE CustomerID NOT IN (
    SELECT CustomerID FROM Orders
);

----------------------------------------------------------------
-- 3. Single-Row Subquery
-- Find the product with the highest price
SELECT *
FROM Product
WHERE Price = (
    SELECT MAX(Price) FROM Product
);

----------------------------------------------------------------
-- 4. Subquery in SELECT Clause
-- Display order ID and total amount for each order
SELECT 
    OrderID,
    (SELECT TotalAmount 
     FROM Orders O2 
     WHERE O2.OrderID = O1.OrderID) AS Total_Amount
FROM Orders O1;

----------------------------------------------------------------
-- 5. Subquery in FROM Clause
-- Find customers whose total purchase amount is greater than 30000
SELECT CustomerID, TotalPurchase
FROM (
    SELECT CustomerID, SUM(TotalAmount) AS TotalPurchase
    FROM Orders
    GROUP BY CustomerID
) AS PurchaseData
WHERE TotalPurchase > 30000;

----------------------------------------------------------------
-- 6. Correlated Subquery
-- Find products more expensive than average product price
SELECT *
FROM Product P1
WHERE Price > (
    SELECT AVG(Price)
    FROM Product P2
);

----------------------------------------------------------------
-- 7. Subquery with EXISTS
-- List customers who have ordered at least one product
SELECT *
FROM Customer C
WHERE EXISTS (
    SELECT *
    FROM Orders O
    WHERE C.CustomerID = O.CustomerID
);
