-- View all data
SELECT * FROM Customer;
SELECT * FROM Product;
SELECT * FROM Orders;
 
-- 1. IN: Customers who HAVE placed orders
SELECT Name FROM Customer
WHERE  CustID IN (SELECT CustID FROM Orders);
 
-- 2. NOT IN: Customers who have NOT placed any order
SELECT Name FROM Customer
WHERE  CustID NOT IN (SELECT CustID FROM Orders);
 
-- 3. Single-row subquery (=): Product with the highest price
SELECT ProdName, Price FROM Product
WHERE  Price = (SELECT MAX(Price) FROM Product);
 
-- 4. Subquery in SELECT: Customer name alongside each order
SELECT OrderID,
       (SELECT Name FROM Customer
        WHERE  Customer.CustID = Orders.CustID) AS CustomerName,
       TotalAmt
FROM   Orders;
 
-- 5. Subquery in FROM: Customers with total purchase > 30000
SELECT C.Name, S.TotalPurchase
FROM   Customer C
JOIN   (
    SELECT CustID, SUM(TotalAmt) AS TotalPurchase
    FROM   Orders
    GROUP  BY CustID
) AS S ON C.CustID = S.CustID
WHERE  S.TotalPurchase > 30000;
 
-- 6. Correlated subquery: Products above average price
SELECT ProdName, Price FROM Product
WHERE  Price > (SELECT AVG(Price) FROM Product);
 
-- 7. EXISTS: Customers who have ordered at least one product
SELECT Name FROM Customer C
WHERE  EXISTS (
    SELECT 1 FROM Orders O WHERE O.CustID = C.CustID
);
